            Method  Override  Control  .  Has Focus  .  Set
                  //  Translate  ...
                  /*
                  If Not Screen Is Nothing Then
                        If sHasFocus Then
                              With Screen.FocusedControls
                                    IdInScreenFocusedControls = .Add
                                    Set .Item(IdInScreenFocusedControls) = This
                              End With
                        Else
                              Screen.FocusedControls.Remove IdInScreenFocusedControls
                        End If
                  End If
                  RaiseEvent HasFocusChanged
                  */
            End  Method

            Method  Override  Control  .  Full Name  .  Get
                  //  Translate  ...
                  /*
                  If Not Parent Is Nothing Then FullName = Parent.Name + " . "
                  FullName = FullName + Name
                  */
            End  Method            

            Method  Override  Control  .  Overruled Visible  .  Get
                  //  Translate  ...
                  /*
                  OverruledVisible = Visible
                  If Not Parent Is Nothing Then If Not Parent.Visible Then OverruledVisible = False
                  */
            End  Method

            Method  Override  Control  .  Left In Screen  .  Get
                  //  Translate  ...
                  /*
                  LeftInScreen = Left
                  If Not Parent Is Nothing Then LeftInScreen = LeftInScreen + Parent.LeftInScreen
                  */
            End  Method

            Method  Override  Control  .  Top In Screen  .  Get
                  //  Translate  ...
                  /*
                  TopInScreen = Top
                  If Not Parent Is Nothing Then TopInScreen = TopInScreen + Parent.TopInScreen
                  */
            End  Method

