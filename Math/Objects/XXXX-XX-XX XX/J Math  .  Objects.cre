                  End  Method

                  Method  Override  Boolean  .  Operator Type  .  Get
                        return  "2"  ;
                  End  Method

                  Method  Override  Boolean  .  Priority  .  Get
                        return  "15"  ;  //  Value  Priority
                  End  Method

      //  Operations

            //  Arithmetic

                  //  +

                        Method  Override  +  .  Result  .  Get
                              CItem*  tItem  =  aThis  ->  RelatedItems  (  )  ->  ParentItem  (  )  ;
                              CItem*  tA  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "A"  )  ->  Item  (  )  ;
                              CItem*  tB  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "B"  )  ->  Item  (  )  ;
                              CItem*  tResult  =  aThis  ->  ItemBase  (  )  ;
                              if  (  tA  ==  0  ||  tB  ==  0  ||  tResult  ==  0  )  {  return  0  ;  }
                              double  tAValue  =  StringToDouble  (  tA  ->  ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  )  )  ;
                              double  tBValue  =  StringToDouble  (  tB  ->  ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  )  )  ;
                              CString  tResultValue  =  DoubleToString  (  tAValue  +  tBValue  )  ;
                              tResult  ->  ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  tResultValue  )  ;
                              return  tResult  ;
                        End  Method

                        Method  Override  +  .  Literal  .  Get
                              CItem*  tItem  =  aThis  ->  ItemAttributes  (  )  ->  ParentItem  (  )  ;
                              CItem*  tResult  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Result"  )  ->  Item  (  )  ;
                              return  tResult  ->  ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  )  ;
                        End  Method

                        Method  Override  +  .  Symbol  .  Get
                              return  "+"  ;
                        End  Method

                        Method  Override  +  .  Operator Type  .  Get
                              return  "3"  ;
                        End  Method

                        Method  Override  +  .  Priority  .  Get
                              return  "11"  ;  //  Add  &  Substract  Priority
                        End  Method

                  //  -

                        Method  Override  -  .  Result  .  Get
                              CItem*  tItem  =  aThis  ->  RelatedItems  (  )  ->  ParentItem  (  )  ;
                              CItem*  tA  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "A"  )  ->  Item  (  )  ;
                              CItem*  tB  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "B"  )  ->  Item  (  )  ;
                              CItem*  tResult  =  aThis  ->  ItemBase  (  )  ;
                              if  (  tA  ==  0  ||  tB  ==  0  ||  tResult  ==  0  )  {  return  0  ;  }
                              double  tAValue  =  StringToDouble  (  tA  ->  ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  )  )  ;
                              double  tBValue  =  StringToDouble  (  tB  ->  ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  )  )  ;
                              CString  tResultValue  =  DoubleToString  (  tAValue  -  tBValue  )  ;
                              tResult  ->  ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  tResultValue  )  ;
                              return  tResult  ;
                        End  Method

                        Method  Override  -  .  Literal  .  Get
                              CItem*  tItem  =  aThis  ->  ItemAttributes  (  )  ->  ParentItem  (  )  ;
                              CItem*  tResult  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Result"  )  ->  Item  (  )  ;
                              return  tResult  ->  ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  )  ;
                        End  Method

                        Method  Override  -  .  Symbol  .  Get
