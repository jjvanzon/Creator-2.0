//  Methods

      //  Objects

            //  Number

                  Method  Override  Number  .  Result  .  Get
                        return  aThis  ->  RelatedItems  (  )  ->  ParentItem  (  )  ;
                  End  Method

                  Method  Override  Number  .  Literal  .  Get
                        CItem*  tItem  =  aThis  ->  ItemAttributes  (  )  ->  ParentItem  (  )  ;
                        return  tItem  ->  ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  )  ;
                  End  Method

                  Method  Override  Number  .  Operator Type  .  Get
                        return  "1"  ;
                  End  Method

                  Method  Override  Number  .  Priority  .  Get
                        return  "15"  ;  //  Value  Priority
                  End  Method

            //  Boolean

                  Method  Override  Boolean  .  Result  .  Get
                        return  aThis  ->  RelatedItems  (  )  ->  ParentItem  (  )  ;
                  End  Method

                  Method  Override  Boolean  .  Literal  .  Get
                        CItem*  tItem  =  aThis  ->  ItemAttributes  (  )  ->  ParentItem  (  )  ;
