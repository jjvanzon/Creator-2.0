            Method  Override  Multiply  .  Result  .  Get
                  CItem* tItem = aThis -> ItemAttributes ( ) -> ParentItem ( ) ;
                  CItem* tOperandA = tItem -> RelatedItems ( ) -> Item ( "Operand A" ) -> Item ( ) ;
                  if ( tOperandA == 0 )  { return "" ; }
                  CItem* tOperandB = tItem -> RelatedItems ( ) -> Item ( "Operand B" ) -> Item ( ) ;
                  if ( tOperandB == 0 )  { return "" ; }
                  CString tItemBaseTime = tItem -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ;
                  tOperandA -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( tItemBaseTime ) ;
                  tOperandB -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( tItemBaseTime ) ;
                  CItem* tAxis = tItem -> RelatedItems ( ) -> Item ( "Axis" ) -> Item ( ) ;
                  if ( tAxis == 0 ) {
                        return DoubleToString (
                              StringToDouble ( tOperandA -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) *
                              StringToDouble ( tOperandB -> ItemAttributes ( ) -> Item ( "Result" )  -> Value ( ) )
                          ) ;
                  }
                  else {
                        tAxis -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( tItemBaseTime ) ;
                        double tAxisResult = StringToDouble ( tAxis -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                        double tOperandAResult = StringToDouble ( tOperandA -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                        double tOperandBResult = StringToDouble ( tOperandB -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                        return DoubleToString ( ( tOperandAResult - tAxisResult ) * tOperandBResult + tAxisResult ) ;
                  }
            End  Method
    
            Method  Override  Divide  .  Result  .  Get
                  CItem* tItem = aThis -> ItemAttributes ( ) -> ParentItem ( ) ;
                  CItem* tOperandA = tItem -> RelatedItems ( ) -> Item ( "Numerator" ) -> Item ( ) ;
                  if ( tOperandA == 0 )  { return "" ; }
                  CItem* tOperandB = tItem -> RelatedItems ( ) -> Item ( "Denominator" ) -> Item ( ) ;
                  if ( tOperandB == 0 )  { return "" ; }
                  CString tItemBaseTime = tItem -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ;
                  tOperandA -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( tItemBaseTime ) ;
                  tOperandB -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( tItemBaseTime ) ;
                  CItem* tAxis = tItem -> RelatedItems ( ) -> Item ( "Axis" ) -> Item ( ) ;
                  double  tOperandBResult  =  StringToDouble  (  tOperandB -> ItemAttributes ( ) -> Item ( "Result" )  -> Value ( )  )  ;
                  if ( tAxis == 0 ) {
                        if  (  tOperandBResult  == 0.0  ) {  return  ""  ;  }
                        return DoubleToString (
                              StringToDouble ( tOperandA -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) /
                              tOperandBResult
                          ) ;
                  }
                  else {
                        tAxis -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( tItemBaseTime ) ;
                        double tAxisResult = StringToDouble ( tAxis -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                        if  (  tOperandBResult  ==  0.0  ) {  return  DoubleToString  (  tAxisResult  )  ;  }
                        double tOperandAResult = StringToDouble ( tOperandA -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                        return DoubleToString ( ( tOperandAResult - tAxisResult ) / tOperandBResult + tAxisResult ) ;
                  }
            End  Method

            Method  Override  Power  .  Result  .  Get
                  CItem* tItem = aThis -> ItemAttributes ( ) -> ParentItem ( ) ;
                  CItem*  tArithmeticBase  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Arithmetic Base"  )  ->  Item  (  )  ;
                  if  (  tArithmeticBase  ==  0  )  {  return  ""  ;  }
                  CItem*  tExponent  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Exponent"  )  ->  Item  (  )  ;
                  if  (  tExponent  ==  0  )  {  return  ""  ;  }
                  CString  tTime  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  )  ;
                  tArithmeticBase  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  tTime  )  ;
                  tExponent  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  tTime  )  ;
                  return  DoubleToString  (  pow  (  
                        StringToDouble  (  tArithmeticBase  ->  ItemAttributes  (  )  ->  Item  (  "Result"  )  -> Value  (  )  )  ,
                        StringToDouble  (  tExponent  ->  ItemAttributes  (  )  ->  Item  (  "Result"  )  -> Value  (  )  )
                    ))  ;
            End  Method

            Method  Override  Time Add  .  Result  .  Get
                  //  If Level Is Nothing Then Exit Property
                        CItem*  tItem  =  aThis  ->  ItemAttributes  (  )  ->  ParentItem  (  )  ;
                        CItem*  tBase  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ;
                        CItem*  tLevel  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Level"  )  ->  Item  (  )  ;
                        CItem*  tTimeDifference  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Time Difference"  )  ->  Item  (  )  ;
                        double  tTime  =  StringToDouble  ( tBase  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  -> Value  (  )  )  ;
                        if  (  tLevel  ==  0  )  {  return  ""  ;  }  
                  //  Dim tTimeDifference As Double
                        double  tTimeDifferenceResult  =  0  ;
                  //  If Not TimeDifference Is Nothing Then
                        if  (  tTimeDifference  !=  0  )  {
                              //  TimeDifference.Time = Time
                                    CItem*  tTimeDifferenceBase  =  tTimeDifference  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ;
                                    tTimeDifferenceBase  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  DoubleToString  (  tTime  )  )  ;
                              //  tTimeDifference = TimeDifference.Result
                                    tTimeDifferenceResult  =  StringToDouble  ( tTimeDifference  ->  ItemAttributes  (  )  ->  Item  (  "Result"  )  -> Value  (  )  )  ;
                        }
                  //  Level.Time = Time + tTimeDifference
                        CItem*  tLevelBase  =  tLevel  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ;
                        tLevelBase  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  DoubleToString  (  tTime  +  tTimeDifferenceResult  )  )  ;
                  //  Result = Level.Result
                        return  tLevel  ->  ItemAttributes  (  )  ->  Item  (  "Result"  )  ->  Value  (  )  ;
            End  Method

