            Method  Override  Time Divide  .  Result  .  Get
                  //  If Level Is Nothing Then Exit Property
                        CItem*  tItem  =  aThis  ->  ItemAttributes  (  )  ->  ParentItem  (  )  ;
                        CItem*  tBase  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ;
                        CItem*  tLevel  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Level"  )  ->  Item  (  )  ;
                        CItem*  tTimeDivider  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Time Divider"  )  ->  Item  (  )  ;
                        double  tTime  =  StringToDouble  ( tBase  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  -> Value  (  )  )  ;
                        if  (  tLevel  ==  0  )  {  return  ""  ;  }  
                  //  Dim tTimeDivider As Double
                        double  tTimeDividerResult  =  1  ;
                  //  If Not TimeDivider Is Nothing Then
                        if  (  tTimeDivider  !=  0  )  {
                              //  TimeDivider.Time = Time
                                    CItem*  tTimeDividerBase  =  tTimeDivider  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ;
                                    tTimeDividerBase  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  DoubleToString  (  tTime  )  )  ;
                              //  tTimeDivider = TimeDivider.Result
                                    tTimeDividerResult  =  StringToDouble  ( tTimeDivider  ->  ItemAttributes  (  )  ->  Item  (  "Result"  )  -> Value  (  )  )  ;
                              //  If tTimeDivider = 0 Then tTimeDivider = 1
                                    if  (  tTimeDividerResult  ==  0  )  {  tTimeDividerResult  =  1  ;  }
                        }
                  //  Level.Time = Time + tTimeDivider
                        CItem*  tLevelBase  =  tLevel  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ;
                        tLevelBase  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  DoubleToString  (  tTime  /  tTimeDividerResult  )  )  ;
                  //  Result = Level.Result
                        return  tLevel  ->  ItemAttributes  (  )  ->  Item  (  "Result"  )  ->  Value  (  )  ;
            End  Method

            Method  Override  Sine  .  Result  .  Get
                // If Volume Is Nothing Or Pitch Is Nothing Then Exit Property
                    if (
                        aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Volume" ) -> Item ( ) == 0 ||
                        aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Pitch" ) -> Item ( ) == 0
                    )
                    {
                        return "" ;
                    }
                // Extra's 
                    double Pi = 3.1415926535897932384626433832795 ;
                // If Level Is Nothing And PhaseStart Is Nothing Then
                    if (
                        aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Level" ) -> Item ( ) == 0 &&
                        aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Phase Start" ) -> Item ( ) == 0
                    )
                    {
                        // Volume.Time = Time
                            aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Volume" ) -> Item ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value (
                                aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ) ;
                        // Pitch.Time = Time
                            aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Pitch" ) -> Item ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value (
                                aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ) ;
                        // Extra's
                            double tVolume = StringToDouble ( aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Volume" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                            double tPitch = StringToDouble ( aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Pitch" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                            double tTime = StringToDouble ( aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ) ;
                        // Result = Volume.Result * Sin(2 * Pi * Pitch.Result * Time)
                            return DoubleToString ( tVolume * sin ( 2 * Pi * tPitch * tTime ) ) ;
                    }
                // Else
                    else
                    {
                        // Dim tLevel As Double
                            double tLevel = 0;
                        // Dim tPhaseStart As Double
                            double tPhaseStart = 0;
                        // Volume.Time = Time
                            aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Volume" ) -> Item ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value (
                                aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ) ;
                        // Pitch.Time = Time
                            aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Pitch" ) -> Item ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value (
                                aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ) ;
                        // If Not Level Is Nothing Then
                            if (aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Level" ) -> Item ( ) != 0 ) {
                                // Level.Time = Time
                                    aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Level" ) -> Item ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value (
                                        aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ) ;
                                // tLevel = Level.Result
                                    tLevel = StringToDouble ( aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Level" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) );
                            }
                        // If Not PhaseStart Is Nothing Then
                            if (aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Phase Start" ) -> Item ( ) != 0 ) {
                                // PhaseStart.Time = Time
                                    aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Phase Start" ) -> Item ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value (
                                        aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ) ;
                                // tPhaseStart = PhaseStart.Result
                                    tPhaseStart = StringToDouble ( aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Phase Start" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) );
                            }
                        // Extra's
                            double tVolume = StringToDouble ( aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Volume" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                            double tPitch = StringToDouble ( aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Pitch" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                            double tTime = StringToDouble ( aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ) ;
                        // Result = tLevel + Volume.Result * Sin((tPhaseStart * 2 * Pi) + 2 * Pi * Pitch.Result * Time)
                            return DoubleToString ( tLevel + tVolume * sin ( ( tPhaseStart * 2 * Pi ) + 2 * Pi * tPitch * tTime ) ) ;
                    }
            End  Method

            Method  Override  Outlet  .  Result  .  Get
                // If Operand Is Nothing Then Exit Property
                    if ( aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Operand" ) -> Item ( ) == 0 ) { return "" ; }
                // Operand.Time = Time
                    aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Operand" ) -> Item ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value (
                        aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ) ;
                // Result = Operand.Result
                    return aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Operand" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ;
            End  Method

      //  Other  Objects

            Method  Wave File Output  .  Start
                // Extra
                    double tRealTimePerVirtualTime = StringToDouble ( aThis -> ItemMethods ( ) -> ParentItem ( ) -> ItemAttributes ( ) -> Item ( "Real Time Per Virtual Time" ) -> Value ( ) ) ;
                // If RealTimePerVirtualTime = 0 Then Exit Function
                    if ( tRealTimePerVirtualTime == 0.0 ) { return ; }
                // Extra
                    double tSamplingRate = StringToDouble ( aThis -> ItemMethods ( ) -> ParentItem ( ) -> ItemAttributes ( ) -> Item ( "Sampling Rate" ) -> Value ( ) ) ;
                // If SamplingRate = 0 Then Exit Function
                    if ( tSamplingRate == 0.0 ) { return ; }
                // Extra
                    CString tFilePath = aThis -> ItemMethods ( ) -> ParentItem ( ) -> ItemAttributes ( ) -> Item ( "File Path" ) -> Value ( ) ;
                // If FilePath = "" Then Exit Function
                    if ( tFilePath == "" ) { return ; }
                // If FileExists(FilePath) Then Kill FilePath
                    if ( FileExists ( tFilePath ) ) { DeleteFile ( tFilePath ) ; }
                // Start = True
                    // Not translated
                // Dim t As Double
                    double t ;
                // Dim tFileNumber As Long
                    HANDLE tFileNumber ;
                // Dim tDouble As Double
                    double tDouble ;
                // Dim tInteger As Integer
                    short tInteger ;
                // Dim tStep As Double
                    double tStep ;
                // tStep = 1 / RealTimePerVirtualTime / SamplingRate
                    tStep = 1.0 / tRealTimePerVirtualTime / tSamplingRate ;
                // Extra
                    DWORD tBytesWritten ;
                // tFileNumber = FreeFile
                // Open FilePath For Binary As tFileNumber
                    tFileNumber = CreateFile ( tFilePath , GENERIC_WRITE , FILE_SHARE_READ , 0 , OPEN_ALWAYS , FILE_ATTRIBUTE_NORMAL , 0 ) ;
                    // Extra
                        double tStartTime = StringToDouble ( aThis -> ItemMethods ( ) -> ParentItem ( ) -> ItemAttributes ( ) -> Item ( "Start Time" ) -> Value ( ) ) ;
                        double tEndTime = StringToDouble ( aThis -> ItemMethods ( ) -> ParentItem ( ) -> ItemAttributes ( ) -> Item ( "End Time" ) -> Value ( ) ) ;
                     // For t = StartTime To EndTime Step tStep
                        for ( t = tStartTime ; t <= tEndTime ; t += tStep ) {
                            // tDouble = 0
                                tDouble = 0 ;
                            // If Not LeftChannel Is Nothing Then
                                if ( aThis -> ItemMethods ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Left Channel" ) -> Item ( ) != 0 ) {
                                    // LeftChannel.Time = t
                                        aThis -> ItemMethods ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Left Channel" ) -> Item ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( DoubleToString ( t ) ) ;
                                    // tDouble = tDouble + LeftChannel.Result
                                        tDouble += StringToDouble ( aThis -> ItemMethods ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Left Channel" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                                }
                            // If Not RightChannel Is Nothing Then
                                if ( aThis -> ItemMethods ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Right Channel" ) -> Item ( ) != 0 ) {
                                    // RightChannel.Time = t
                                        aThis -> ItemMethods ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Right Channel" ) -> Item ( ) -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( DoubleToString ( t ) ) ;
                                    // tDouble = tDouble + RightChannel.Result
                                        tDouble += StringToDouble ( aThis -> ItemMethods ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Reft Channel" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Result" ) -> Value ( ) ) ;
                                }
                            // tDouble = tDouble * Amplifier
                                tDouble = tDouble * StringToDouble ( aThis -> ItemMethods ( ) -> ParentItem ( ) -> ItemAttributes ( ) -> Item ( "Amplifier" ) -> Value ( ) ) ;
                            // If tDouble > 32767 Then tDouble = 32767
                                if ( tDouble > 32767 ) { tDouble = 32767 ; } 
                            // If tDouble < -32768 Then tDouble = -32768
                                if ( tDouble < -32768 ) { tDouble = -32768 ; } 
                            // tInteger = Fix(tDouble)
                                tInteger = ( int ) tDouble ;
                            // Put tFileNumber, , tInteger
                                WriteFile ( tFileNumber , & tInteger  , 2 , & tBytesWritten , 0 ) ;
                        }
                // Close tFileNumber
                    CloseHandle ( tFileNumber ) ;
                // MsgBox "Done."
                    MessageBox ( 0 , "Done." , "" , MB_OK ) ;
            End  Method

            Method  Workspace  .  Hello World
                MessageBox ( 0 , "Hello world!" , "" , MB_OK ) ;
            End  Method

        Method  Override  Curve  .  Value  .  Get
              //  Declarations
                    int  i  ;
                    CItem*  tNodeA  ;
                    CItem*  tNodeB  ;
                    CItem*  tItem  =  aThis  ->  ItemAttributes  (  )  ->  ParentItem  (  )  ;
                    double  tTime  =  StringToDouble  (  tItem  ->  ItemAttributes  (  )  -> Item  (  "Time"  )  ->  Value  (  )  )  ;
              //  Find  the  nodes  the  time  is  in  between
                    CRelatedList*  tNodes  =  tItem  ->  RelatedLists  (  )  ->  Item  (  "Nodes"  )  ;
                    CItem*  tNode  ;
                    for  (  i  =  0  ;  i  <=  tNodes  ->  StorageCount  (  )  -  1  ;  i  ++  )  {
                          if  (  tNodes  ->  PositionUsed  (  i  )  ==  TRUE  )  {
                                tNode  =  tNodes  ->  Item  (  i  )  ;
                                if  (  StringToDouble  (  tNode  -> ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  )  )  >  tTime  )  {
                                      tNodeB  =  tNode  ;
                                      break  ;
                                }
                                tNodeA  =  tNode  ;
                          }
                    }
                    if  (  tNodeA  ==  0  ||  tNodeB  ==  0  )  {  return  ""  ;  }
                //  Calculate the Value
                      CString  tNodeType  =  tNodeA  ->  ItemAttributes  (  )  ->  Item  (  "Type"  )  ->  Value  (  )  ;
                      if  (  tNodeType  ==  "0"  )  {
                            //  Off Node Type
                                  return  "0"  ;
                      }
                      if  (  tNodeType  ==  "1"  )  {
                            //  Block Node Type
                                  return  tNodeA  -> ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  )  ;
                      }
                      if  (  tNodeType  ==  "2"  )  {
                            //  Line Node Type
                                  double  tNodeATime  =  StringToDouble  (  tNodeA  ->  ItemAttributes  (  )  -> Item  (  "Time"  )  ->  Value  (  )  )  ;
                                  double  tNodeBTime  =  StringToDouble  (  tNodeB  ->  ItemAttributes  (  )  -> Item  (  "Time"  )  ->  Value  (  )  )  ;
                                  double  tNodeAValue  =  StringToDouble  (  tNodeA  ->  ItemAttributes  (  )  -> Item  (  "Value"  )  ->  Value  (  )  )  ;
                                  if  (  tNodeBTime <= tNodeATime  )  {
                                        return  DoubleToString (  tNodeAValue  )  ;
                                  }
                                  double  tNodeBValue  =  StringToDouble  (  tNodeB  ->  ItemAttributes  (  )  -> Item  (  "Value"  )  ->  Value  (  )  )  ;
                                  return  DoubleToString  (  tNodeAValue  +  (  tNodeBValue  -  tNodeAValue  )  *  (  (  tTime  -  tNodeATime  )  /  (  tNodeBTime  -  tNodeATime  )  )  )  ;
                      }
                      /*
                        Case CurveNodeType
                            With JMathMisc.Interpolate
                                .DerivedDirection = True
                                'Times
                                    .TimeMinus1 = tNodeA.Time
                                    .Time0 = tNodeA.Time
                                    .Time1 = tNodeB.Time
                                    .Time2 = tNodeB.Time
                                'Values
                                    .ValueMinus1 = tNodeA.Value
                                    .Value0 = tNodeA.Value
                                    .Value1 = tNodeB.Value
                                    .Value2 = tNodeB.Value
                                'Result
                                    .Time = aTime
                                    Value = .Value
                            End With
                        Case DirectedNodeType
                            With JMathMisc.Interpolate
                                .DerivedDirection = False
                                'Time
                                    .TimeMinus1 = tNodeA.Time
                                    .Time0 = tNodeA.Time
                                    .Time1 = tNodeB.Time
                                    .Time2 = tNodeB.Time
                                'Value
                                    .ValueMinus1 = tNodeA.Value
                                    .Value0 = tNodeA.Value
                                    .Value1 = tNodeB.Value
                                    .Value2 = tNodeB.Value
                                'Direction
                                    .Direction0 = tNodeA.Direction
                                    .Direction1 = tNodeB.Direction
                                'Result
                                    .Time = aTime
                                    Value = .Value
                            End With
                      */
        End  Method

        Method  Override  Curve In  .  Result  .  Get
              CItem*  tItem  =  aThis  ->  ItemAttributes  (  )  ->  ParentItem  (  )  ;
              CItem*  tCurve  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Curve"  )  ->  Item  (  )  ;
              if  (  tCurve  ==  0  )  {  return  ""  ;  }
              CString  tTime  =  tItem  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  )  ;
              tCurve  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  tTime  )  ;
              return  tCurve  ->  ItemAttributes  (  )  ->  Item  (  "Value"  )  ->  Value  (  )  ;
        End  Method

        Method  Override  Sample  .  Value  .  Get
              CItem* tItem = aThis -> ItemAttributes ( ) -> ParentItem ( ) ;
              // If Not Loaded Or Not Active Then Exit Function
                    bool tLoaded = StringToBoolean ( tItem -> ItemAttributes ( ) -> Item ( "Loaded" ) -> Value ( ) ) ;
                    if ( ! tLoaded ) { return "" ; }
                    bool tActive = StringToBoolean ( tItem -> ItemAttributes ( ) -> Item ( "Active" ) -> Value ( ) ) ;
                    if ( ! tActive ) { return "" ; }
              // If RealTimePerSampleTime = 0 Then Exit Function
                    double tRealTimePerSampleTime = StringToDouble ( tItem -> ItemAttributes ( ) -> Item ( "Real Time Per Virtual Time" ) -> Value ( ) ) ;
                    if ( tRealTimePerSampleTime == 0 ) { return "" ; }
              // Dim tSample As Double
              // tSample = (aTime * SamplingRate) / RealTimePerSampleTime
                    double tTime = StringToDouble ( tItem -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ) ;
                    double tSamplingRate = StringToDouble ( tItem -> ItemAttributes ( ) -> Item ( "Sampling Rate" ) -> Value ( ) ) ;
                    double tSamplePosition = ( tTime * tSamplingRate ) / tRealTimePerSampleTime ;
              // 'Met deze exit mis je altijd  de laatste sample
                    // If Int(tSample) < 0 Then Exit Function
                          if ( floor ( tSamplePosition ) < 0 ) { return "" ; }
                    // If Int(tSample) + 1 > UBound(Samples) Then Exit Function
                          CRelatedList* tSamples = tItem -> RelatedLists ( ) -> Item ( "Samples" ) ;
                          if ( floor ( tSamplePosition ) + 1 > tSamples -> ListCount ( ) - 1 ) { return "" ; }
              // Dim tSample1 As Double
                    CItem* tSample1Item ;
                    double tSample1Value ;
              // Dim tSample2 As Double
                    CItem* tSample2Item ;
                    double tSample2Value ;
              // Dim Interpoint As Double
                    double tInterpoint ;
              double tReturnValue ;
              // Select Case Interpolation
                    int tInterpolation = StringToInteger ( tItem -> ItemAttributes ( ) -> Item ( "Interpolation" ) -> Value ( ) ) ;
                    // Case BlockInterpolation
                          if  ( tInterpolation == 0 ) {
                                // Value = Samples(Int(tSample))
                                      CItem* tSampleItem = tSamples -> Item ( ( int ) floor ( tSamplePosition ) ) ;
                                      tReturnValue = StringToDouble ( tSampleItem -> ItemAttributes ( ) -> Item ( "Value" ) -> Value ( )  ) ;
                          }
                    // Case LineInterpolation
                          if ( tInterpolation == 1 ) {
                              // tSample1 = Samples(Int(tSample))
                                    tSample1Item = tSamples -> Item ( ( int ) floor ( tSamplePosition ) ) ;
                                    tSample1Value = StringToDouble ( tSample1Item -> ItemAttributes ( ) -> Item ( "Value" ) -> Value ( ) ) ;
                              // tSample2 = Samples(Int(tSample) + 1)
                                    tSample2Item = tSamples -> Item ( ( int ) floor ( tSamplePosition ) + 1 ) ;
                                    tSample2Value = StringToDouble ( tSample2Item -> ItemAttributes ( ) -> Item ( "Value" ) -> Value ( ) ) ;
                              // Interpoint = tSample - Int(tSample)
                                    tInterpoint = tSamplePosition - floor ( tSamplePosition ) ;
                              // Value = tSample1 + (tSample2 - tSample1) * Interpoint
                                    tReturnValue = tSample1Value + ( tSample2Value - tSample1Value ) * tInterpoint ;
                          }
                    // Case CurveInterpolation
                          if ( tInterpolation == 2 ) {
                              // 'Not supported yet: calculated as linear
                              // tSample1 = Samples(Int(tSample))
                                    tSample1Item = tSamples -> Item ( ( int ) floor ( tSamplePosition ) ) ;
                                    tSample1Value = StringToDouble ( tSample1Item -> ItemAttributes ( ) -> Item ( "Value" ) -> Value ( ) ) ;
                              // tSample2 = Samples(Int(tSample) + 1)
                                    tSample2Item = tSamples -> Item ( ( int ) floor ( tSamplePosition ) + 1 ) ;
                                    tSample2Value = StringToDouble ( tSample2Item -> ItemAttributes ( ) -> Item ( "Value" ) -> Value ( ) ) ;
                              // Interpoint = tSample - Int(tSample)
                                    tInterpoint = tSamplePosition - floor ( tSamplePosition ) ;
                              // Value = tSample1 + (tSample2 - tSample1) * Interpoint
                                    tReturnValue = tSample1Value + ( tSample2Value - tSample1Value ) * tInterpoint ;
                          }
              // End Select
              // Value = Value * Amplifier
                    double tAmplifier = StringToDouble ( tItem -> ItemAttributes ( ) -> Item ( "Amplifier" ) -> Value ( ) ) ;
                    tReturnValue = tReturnValue * tAmplifier ;
                    return DoubleToString ( tReturnValue ) ;
         End  Method

        Method  Sample  .  Load
              // Dim i As Long
                    int i ;
              // Dim tFileNumber As Long
                    HANDLE tFileHandle ;
              // Dim tFilePosition As Long
              // Dim tInteger As Integer
                    short tShort ;
              // Dim tByte As Byte
                    char tByte ;
              // tFileNumber = FreeFile
              // Open FilePath For Binary As tFileNumber
                    CString tFilePath = aThis -> ItemMethods ( ) -> ParentItem ( ) -> ItemAttributes ( ) -> Item ( "File Path" ) -> Value ( ) ;
                    tFileHandle = CreateFile ( tFilePath , GENERIC_READ , FILE_SHARE_READ , 0 , OPEN_EXISTING , FILE_ATTRIBUTE_NORMAL , 0 ) ;
                    if ( tFileHandle == INVALID_HANDLE_VALUE ) { return ; }
              // For i = 1 To BytesToSkip
                    CItem* tItem = aThis -> ItemMethods ( ) -> ParentItem ( ) ;
                    int tBytesToSkip = StringToInteger ( tItem -> ItemAttributes ( ) -> Item ( "Bytes To Skip" ) -> Value ( ) ) ;
                    DWORD tBytesRead ;
                    for ( i = 1 ; i <= tBytesToSkip ; i ++ ) {
                          // Get tFileNumber, , tByte
                                ReadFile ( tFileHandle , & tByte , 1 , & tBytesRead , 0 ) ;
                    }
              // ReDim Samples((LOF(tFileNumber) - BytesToSkip) / 2)
                    CRelatedList* tSamples = tItem -> RelatedLists ( ) -> Item ( "Samples" ) ;
                    tSamples -> Clear ( ) ;
              // For i = 1 To (LOF(tFileNumber) - BytesToSkip) / 2
                    CItem* tSample ;
                    // Get tFileNumber, , tInteger
                    while ( ReadFile ( tFileHandle , &tShort , 2 , & tBytesRead , 0 ) ) {
                          if ( tBytesRead == 0 ) { break ; } ;
                          tSample = tSamples -> Add ( ) ;
                          // Samples(i) = tInteger
                                tSample -> ItemAttributes ( ) -> Item ( "Value" ) -> Value ( ShortToString ( tShort ) ) ;
                    }
              // Close tFileNumber
                    CloseHandle ( tFileHandle ) ;
              // Loaded = True
                    tItem -> ItemAttributes ( ) -> Item ( "Loaded" ) -> Value ( "True" ) ;
        End  Method

        Method  Sample  .  Unload
              CItem*  tItem  =  aThis  ->  ItemMethods  (  )  ->  ParentItem  (  )  ;
              CRelatedList*  tSamples  =  tItem  ->  RelatedLists  (  )  ->  Item  (  "Samples"  )  ;
              tSamples  ->  Clear  (  )  ;
        End  Method

        Method  Override  Sample Operator  .  Result  .  Get
              // If Sample Is Nothing Then Exit Property
                    CItem* tItem = aThis -> ItemAttributes ( ) -> ParentItem ( ) ;
                    CItem* tSample = tItem -> RelatedItems ( ) -> Item ( "Sample" ) -> Item ( ) ;
                    if ( tSample == 0 ) { return "" ; }
              // Result = Sample.Value(Time)
                    CItem* tBase = tItem -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) ;
                    CString tTime = tBase -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ;
                    tSample -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( tTime ) ;
                    return tSample -> ItemAttributes ( ) -> Item ( "Value" ) -> Value ( ) ;
        End  Method
