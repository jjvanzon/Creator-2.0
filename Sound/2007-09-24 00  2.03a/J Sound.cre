                    strtod ( aThis -> ItemAttributes ( ) -> ParentItem ( ) -> RelatedItems ( ) -> Item ( "Operand B" ) -> Item ( ) -> ItemAttributes ( ) -> Item ( "Result" )  -> Value ( ) , &tStopString )
                    ) ;
