                        if  (  tLevel  ==  0  )  {  return  ""  ;  }  
                  //  Dim tTimeDifference As Double
                        double  tTimeDifferenceResult  =  0  ;
                  //  If Not TimeDifference Is Nothing Then
                        if  (  tTimeDifference  !=  0  )  {
                              //  TimeDifference.Time = Time
                                    CItem*  tTimeDifferenceBase  =  tTimeDifference  ->  RelatedItems  (  )  ->  Item  (  "Base"  )  ->  Item  (  )  ;
                                    tTimeDifferenceBase  ->  ItemAttributes  (  )  ->  Item  (  "Time"  )  ->  Value  (  DoubleToString  (  tTime  )  )  ;
                              //  tTimeDifference = TimeDifference.Result
