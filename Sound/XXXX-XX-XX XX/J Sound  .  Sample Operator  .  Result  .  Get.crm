              // If Sample Is Nothing Then Exit Property
                    CItem* tItem = aThis -> ItemAttributes ( ) -> ParentItem ( ) ;
                    CItem* tSample = tItem -> RelatedItems ( ) -> Item ( "Sample" ) -> Item ( ) ;
                    if ( tSample == 0 ) { return "" ; }
              // Result = Sample.Value(Time)
                    CItem* tBase = tItem -> RelatedItems ( ) -> Item ( "Base" ) -> Item ( ) ;
                    CString tTime = tBase -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( ) ;
                    tSample -> ItemAttributes ( ) -> Item ( "Time" ) -> Value ( tTime ) ;
                    return tSample -> ItemAttributes ( ) -> Item ( "Value" ) -> Value ( ) ;